<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ESPAUTO.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="BrandPrimaryColor">#0A59F7</Color>
            <Color x:Key="StatusSuccessColor">#00B578</Color>
            <Color x:Key="StatusDangerColor">#FF3B30</Color>
            <Color x:Key="StatusWarningColor">#FF9500</Color>

            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccessColor}" />
            <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDangerColor}" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarningColor}" />

            <Thickness x:Key="CardPadding">24</Thickness>
            <CornerRadius x:Key="CardCornerRadius">24</CornerRadius>
            <CornerRadius x:Key="SubCornerRadius">16</CornerRadius>

        </ResourceDictionary>
    </Application.Resources>
</Application>
