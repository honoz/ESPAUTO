<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="15dp"
    tools:context=".MainActivity">

    <RelativeLayout
        android:id="@+id/rl_top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="15dp"
        android:gravity="center_vertical"
        app:layout_scrollFlags="scroll|enterAlways">

        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:text="@string/app_name"
            android:textSize="23sp"
            android:textColor="@color/md_theme_onSurface"/>

        <ImageButton
            android:id="@+id/btn_scan_device"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            android:background="@drawable/ic_connection_bg"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_connection"
            tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:background="@drawable/rounded_rectangle"
        android:padding="10dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_video_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/md_theme_surfaceVariant"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_video_display"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/ll_live_status_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/ic_status_bg"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_live_status_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_live" />

            <TextView
                android:id="@+id/tv_live_status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="center"
                android:text="@string/status_live"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_device_info_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_signal_strength"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_signal_0_bar"
                android:drawablePadding="3dp"
                android:text="---%"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tv_temperature"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:drawableStart="@drawable/ic_thermometer"
                android:drawablePadding="3dp"
                android:text="---℃"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/tv_video_fps"
                android:layout_width="66dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:drawableStart="@drawable/ic_fps"
                android:drawablePadding="3dp"
                android:text="---FPS"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rl_loading_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/fl_icon_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">

                <ImageView
                    android:id="@+id/iv_no_video_icon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_no_video"
                    android:visibility="visible"/>

                <ImageView
                    android:id="@+id/iv_reconnect_icon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_fresh"
                    android:stateListAnimator="@animator/pressed_state_list"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/pb_loading_indicator"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/loadding"
                    android:visibility="gone" />

            </FrameLayout>

            <TextView
                android:id="@+id/tv_loading_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/fl_icon_container"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="15dp"
                android:text="@string/tip_waiting_connection"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

        </RelativeLayout>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="15dp"
        android:layout_weight="0.3"
        android:background="@drawable/rounded_rectangle"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_video_record"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/custom_ripple"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_video"
            tools:ignore="SpeakableTextPresentCheck" />

        <ImageButton
            android:id="@+id/btn_screenshot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/custom_ripple"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera"
            tools:ignore="SpeakableTextPresentCheck" />

        <ImageButton
            android:id="@+id/btn_mode_switch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/custom_ripple"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_portrait_off"
            tools:ignore="SpeakableTextPresentCheck" />

        <ImageButton
            android:id="@+id/btn_device_beep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/custom_ripple"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ring"
            tools:ignore="SpeakableTextPresentCheck" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="15dp"
        android:layout_weight="1.5"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ll_servo_control"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/rounded_rectangle"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_servo_up"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/custom_ripple"
                android:padding="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_up"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/tv_servo_label"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/label_servo"
                android:textColor="@color/md_theme_outline"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_servo_down"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/custom_ripple"
                android:padding="30dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_down"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_right_control_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:paddingStart="15dp">

            <LinearLayout
                android:id="@+id/ll_led_control"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/rounded_rectangle"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                app:layout_constraintBottom_toTopOf="@id/touch_pad_control"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_led_icon"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        app:srcCompat="@drawable/ic_brightness" />

                    <TextView
                        android:id="@+id/tv_led_control_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@string/label_led_control"
                        android:textColor="@color/md_theme_outline"
                        android:textSize="16sp" />

                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_led_brightness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="-7dp"
                    android:layout_marginEnd="-7dp"
                    android:valueFrom="0"
                    android:valueTo="255"
                    app:haloColor="@android:color/transparent"
                    app:labelBehavior="gone"
                    app:thumbColor="@android:color/white"
                    app:thumbRadius="10dp"
                    app:trackColorActive="@color/md_theme_outline"
                    app:trackColorInactive="@color/md_theme_surfaceVariant"
                    app:trackCornerRadius="14dp"
                    app:trackHeight="22dp"
                    tools:ignore="SpeakableTextPresentCheck" />

            </LinearLayout>

            <com.android.espauto.TouchPadView
                android:id="@+id/touch_pad_control"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/rounded_rectangle"
                android:padding="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>